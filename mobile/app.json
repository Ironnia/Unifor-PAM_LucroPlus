{
  "expo": {
    "name": "LucroPlus",
    "slug": "lucroplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "br.com.lucroplus"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.lucroplus"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ]
    ]
  }
}
