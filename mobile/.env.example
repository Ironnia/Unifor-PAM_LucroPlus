# Configuração da URL da API Backend para o aplicativo mobile
# Celular físico (mesma rede Wi-Fi): informe o IP LAN da sua máquina
EXPO_PUBLIC_API_URL=http://SEU_IP_LAN:8080

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# iOS Simulator ou Web Preview na mesma máquina:
# EXPO_PUBLIC_API_URL=http://localhost:8080
